{
  "name": "barakopress",
  "version": "0.4.0",
  "description": "A configurable blog engine for barakoCMS: Next.js server components, cached until the CMS says otherwise.",
  "license": "MIT",
  "author": "Arnel Robles",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "barakopress": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build:package": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "npm run build:package && next dev",
    "build": "npm run build:package && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build:package"
  },
  "dependencies": {
    "marked": "^18.0.0"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "barakocms",
    "headless-cms",
    "blog",
    "blog-engine",
    "nextjs",
    "react-server-components",
    "rss",
    "sitemap"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaryoDev/barakoPress.git"
  },
  "homepage": "https://github.com/BaryoDev/barakoPress#readme",
  "bugs": {
    "url": "https://github.com/BaryoDev/barakoPress/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
