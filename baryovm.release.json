{
  "localRoot": "~/repos/barakoPress",
  "remoteRoot": "/opt/barakopress",
  "sync": [
    "app/",
    "src/",
    "public/",
    "Dockerfile",
    "Caddyfile",
    "compose.yml",
    "package.json",
    "package-lock.json",
    "next.config.ts",
    "press.config.ts",
    "press.plugins.ts",
    "proxy.ts",
    "scripts/plugins.mjs",
    "tsconfig.json",
    "tsconfig.build.json"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".git",
    ".env"
  ],
  "builds": [
    {
      "image": "barakopress-site:latest",
      "dockerfile": "Dockerfile",
      "context": "."
    }
  ],
  "sudo": true,
  "preDeploy": [
    "test -f /opt/barakopress/.env || { echo 'no .env on the VM: copy .env.example, fill it in, and keep it out of the sync'; exit 1; }",
    "grep -Eq '^(PRESS_SECRET|REVALIDATE_SECRET)=.+' /opt/barakopress/.env || { echo 'PRESS_SECRET is empty, the cache would never be invalidated'; exit 1; }"
  ],
  "verify": [
    "d=$(grep -m1 '^SITE_DOMAIN=' .env | cut -d= -f2- | tr -d '\"'\"'\\r'\"'\"') && test -n \"$d\" && curl --fail --silent --show-error --max-time 15 -o /dev/null \"https://$d/\"",
    "d=$(grep -m1 '^SITE_DOMAIN=' .env | cut -d= -f2- | tr -d '\"'\"'\\r'\"'\"') && curl --fail --silent --show-error --max-time 15 -o /dev/null \"https://$d/feed.xml\"",
    "d=$(grep -m1 '^SITE_DOMAIN=' .env | cut -d= -f2- | tr -d '\"'\"'\\r'\"'\"') && curl --fail --silent --show-error --max-time 15 -o /dev/null \"https://$d/sitemap.xml\"",
    "d=$(grep -m1 '^API_DOMAIN=' .env | cut -d= -f2- | tr -d '\"'\"'\\r'\"'\"') && test -n \"$d\" && curl --fail --silent --show-error --max-time 15 -o /dev/null \"https://$d/health\"",
    "d=$(grep -m1 '^SITE_DOMAIN=' .env | cut -d= -f2- | tr -d '\"'\"'\\r'\"'\"') && test \"$(curl --silent --max-time 15 -o /dev/null -w '%{http_code}' -X POST \"https://$d/api/revalidate\")\" = 401"
  ],
  "verifyAttempts": 10,
  "verifyDelaySeconds": 6
}
