# Where this server reads content. Inside compose that is the service name.
CMS_URL=http://localhost:5005
# Only needed for a multi-tenant deployment.
CMS_TENANT=

# The shared secret on the Webhook action of the workflow that invalidates the cache.
# Set the same value here and on the action in barakoBrew. Without it this server refuses
# every delivery, which is safer than accepting unsigned ones.
REVALIDATE_SECRET=

# The public origin, used for absolute links in the feed and the sitemap.
SITE_URL=http://localhost:3000
SITE_NAME=barakoPress
SITE_TAGLINE=A blog on barakoCMS
