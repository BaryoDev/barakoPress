# Where this server reads content. Inside compose that is the service name.
CMS_URL=http://localhost:5005
# Only needed for a multi-tenant deployment.
CMS_TENANT=

# The one secret this server signs with, at least 32 characters: openssl rand -base64 48.
# It keys the Webhook action that invalidates the cache (the value itself on a single site, a
# key per tenant from `npx barakopress revalidate-key <tenant>` with `sites`) and share sessions.
# Without it this server refuses every delivery, which is safer than accepting unsigned ones.
# REVALIDATE_SECRET and PRESS_PREVIEW_SECRET, the older names, are read only while this is unset.
PRESS_SECRET=

# The origins a font stylesheet may be linked from, separated by commas or spaces. Unset, it is
# https://fonts.googleapis.com alone, and a tenant that names a stylesheet anywhere else gets its
# family name from Google Fonts instead. A list of your own replaces that default rather than adding
# to it, so leaving Google Fonts out of it stops every link to Google Fonts.
PRESS_FONT_ORIGINS=

# The browser-facing origins images and media load from over http, separated by commas or spaces,
# such as http://api.localhost:8080 for a local stack whose CMS_URL is an internal name. Only
# localhost, 127.0.0.1 and *.localhost are read; https origins need no entry. Unset, none. Behind
# the bundled Caddyfile its own header policy still allows only https media.
# PRESS_MEDIA_ORIGINS=

# Set to off to stop pages sending their own Content-Security-Policy meta tag, for a deployment that
# sends a policy of its own. Sent only in production. Read when a page renders, so a build-time
# site needs it set when it is built.
# PRESS_CSP=off

# The public origin, used for absolute links in the feed and the sitemap.
SITE_URL=http://localhost:3000
SITE_NAME=barakoPress
SITE_TAGLINE=A blog on barakoCMS
