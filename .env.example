# Where this server reads content. Inside compose that is the service name.
CMS_URL=http://localhost:5005
# Only needed for a multi-tenant deployment.
CMS_TENANT=

# The one secret this server signs with, at least 32 characters: openssl rand -base64 48.
# It keys the Webhook action that invalidates the cache (the value itself on a single site, a
# key per tenant from `npx barakopress revalidate-key <tenant>` with `sites`) and share sessions.
# Without it this server refuses every delivery, which is safer than accepting unsigned ones.
# REVALIDATE_SECRET and PRESS_PREVIEW_SECRET, the older names, are read only while this is unset.
PRESS_SECRET=

# The public origin, used for absolute links in the feed and the sitemap.
SITE_URL=http://localhost:3000
SITE_NAME=barakoPress
SITE_TAGLINE=A blog on barakoCMS
