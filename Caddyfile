# Three hostnames, one proxy, certificates handled for you.
#
# Caddy asks Let's Encrypt for a certificate on first start and renews it on its own, which is why
# a working blog is a compose up and not an afternoon with certbot. The only prerequisite is that
# all three names already point at this machine: the challenge fails otherwise, and it fails
# loudly in the caddy logs rather than silently serving plain http.

{
	email {$ACME_EMAIL}
}

# The blog. Everything a visitor sees.
{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy site:3000

	header {
		# Sent on every response, including the ones Next renders from cache.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The site renders markdown into HTML. lib/markdown.ts escapes raw HTML, so this is the
		# second line rather than the first, and it is cheap.
		X-Frame-Options "SAMEORIGIN"
		# Enforced. The renderer needs 'unsafe-inline' for scripts and styles: Next writes inline
		# scripts for hydration, the variant switch is an inline script, and every block, theme
		# variable and tenant style is an inline <style> or style attribute. Nonces would need every
		# page rendered per request, which the cached build avoids. Everything else is closed.
		#   fonts: the theme's stylesheet links and font files (CSP_FONT_ORIGINS, Google Fonts by default)
		#   scripts: the analytics script origins (CSP_SCRIPT_ORIGINS, none by default)
		#   frames: the embed block's allowed hosts (CSP_FRAME_ORIGINS, the seven default embedHosts by default)
		#   images and media: any https host, since tenant markdown and the CMS media host differ
		#   connect: self only, the site does not call the API from the browser
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' {$CSP_SCRIPT_ORIGINS:}; style-src 'self' 'unsafe-inline' {$CSP_FONT_ORIGINS:https://fonts.googleapis.com https://fonts.gstatic.com}; font-src 'self' data: {$CSP_FONT_ORIGINS:https://fonts.googleapis.com https://fonts.gstatic.com}; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self'; frame-src {$CSP_FRAME_ORIGINS:https://www.youtube-nocookie.com https://www.youtube.com https://youtube.com https://player.vimeo.com https://www.google.com https://open.spotify.com https://w.soundcloud.com}; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
		-Server
	}
}

# The API. Public because the delivery endpoints are anonymous by design, and because the console
# is a browser app that calls it directly.
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# The console. Same box, its own name, so a cookie set here is not set for the blog.
{$CONSOLE_DOMAIN} {
	encode zstd gzip
	reverse_proxy console:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
