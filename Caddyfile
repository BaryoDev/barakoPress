# Three fixed hostnames and any client domain, one proxy, certificates handled for you.
#
# Caddy asks Let's Encrypt for a certificate on first start and renews it on its own, which is why
# a working blog is a compose up and not an afternoon with certbot. The only prerequisite is that
# all three names already point at this machine: the challenge fails otherwise, and it fails
# loudly in the caddy logs rather than silently serving plain http.
#
# A client's own domain needs no edit here. Register the domain on the client's tenant in the CMS,
# point it at SITE_DOMAIN with a CNAME and verify it (docs/deploying.md lists the records): Caddy
# gets the certificate on the first visit and serves the client's site. Before it issues one, Caddy calls the API's TLS check (the on_demand_tls
# permission below), which answers 200 only for a verified domain of an active tenant. Any other
# name gets no certificate, so a stranger cannot make this box request one.

{
	email {$ACME_EMAIL}

	# The permission check for the catch-all block below. The service name, on the compose network:
	# the API already lists it in AllowedHosts, and the request never leaves the host.
	on_demand_tls {
		permission http http://api:8080/api/tenants/tls-ask
	}

	# A request whose Host is not the name its TLS session was opened for gets 421. Without this, a
	# session for one client's domain could carry another name in Host and be routed by it.
	servers {
		strict_sni_host
	}
}

# The blog's response headers, shared by the two blocks that serve it so they cannot drift.
(site_headers) {
	header {
		# Sent on every response, including the ones Next renders from cache.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The site renders markdown into HTML. lib/markdown.ts escapes raw HTML, so this is the
		# second line rather than the first, and it is cheap.
		X-Frame-Options "SAMEORIGIN"
		# Enforced. The renderer needs 'unsafe-inline' for scripts and styles: Next writes inline
		# scripts for hydration, the variant switch is an inline script, and every block, theme
		# variable and tenant style is an inline <style> or style attribute. Nonces would need every
		# page rendered per request, which the cached build avoids. Everything else is closed.
		#   fonts: the theme's stylesheet links and font files (CSP_FONT_ORIGINS, Google Fonts by default)
		#   scripts: the analytics script origins (CSP_SCRIPT_ORIGINS, none by default; the same origins as
		#            PRESS_SCRIPT_ORIGINS, written as https://host separated by spaces)
		#   frames: the embed block's allowed hosts (CSP_FRAME_ORIGINS, the seven default embedHosts by default)
		#   images and media: any https host, since tenant markdown and the CMS media host differ
		#   connect: self, and the analytics origins, since Umami's tracker posts its beacons to its own origin
		#            (a tracker that reports to another origin is blocked)
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' {$CSP_SCRIPT_ORIGINS:}; style-src 'self' 'unsafe-inline' {$CSP_FONT_ORIGINS:https://fonts.googleapis.com https://fonts.gstatic.com}; font-src 'self' data: {$CSP_FONT_ORIGINS:https://fonts.googleapis.com https://fonts.gstatic.com}; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self' {$CSP_SCRIPT_ORIGINS:}; frame-src {$CSP_FRAME_ORIGINS:https://www.youtube-nocookie.com https://www.youtube.com https://youtube.com https://player.vimeo.com https://www.google.com https://open.spotify.com https://w.soundcloud.com}; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
		-Server
	}
}

# The blog. Everything a visitor sees.
{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy site:3000
	import site_headers
}

# A client's own domain. Any name the blocks above and below do not claim lands here, and the
# permission check above decides whether it gets a certificate at all. The site reads the Host
# header, which Caddy passes through, and finds the tenant that holds the domain. Same headers as
# the blog, from the same snippet.
#
# CLIENT_TLS_ISSUER is for the CI check only. compose.yml does not pass it to Caddy, so it is empty
# in a deployment and Caddy's normal issuers (Let's Encrypt, then ZeroSSL) stay in place. The check
# sets it to "issuer internal" in its own override file: Caddy will not request a public certificate
# for a *.localhost name, and CI must never contact a public ACME server, so the check has Caddy's
# own local CA sign the name instead. A value Caddy cannot parse stops it from starting.
https:// {
	tls {
		on_demand
		{$CLIENT_TLS_ISSUER:}
	}
	encode zstd gzip
	reverse_proxy site:3000
	import site_headers
}

# The API. Public because the delivery endpoints are anonymous by design, and because the console
# is a browser app that calls it directly.
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# The console. Same box, its own name, so a cookie set here is not set for the blog.
{$CONSOLE_DOMAIN} {
	encode zstd gzip
	reverse_proxy console:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
