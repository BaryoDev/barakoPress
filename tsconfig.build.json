/*
 * The package build: src to dist, JS plus declarations, one file in and one file out.
 *
 * tsc and not a bundler. The package exports React server components and route handler factories,
 * so the module graph has to survive the build: next/* and react stay external so the consumer's
 * copies are the ones that run, and export names stay what the consumer writes. A bundler is also
 * free to move a "use client" or "use server" directive, which is a file level marker Next reads
 * from the module it resolves, so the build has to leave the first one that arrives where it is.
 * There is no directive in src today. Transpiling per file leaves all of it alone.
 *
 * Every relative import in src carries a `.js` extension. CLAUDE.md section 2a has the measured
 * reason and its limits: a default Next build resolves the extensionless form fine under both
 * bundlers, `experimental.fullySpecified` on webpack does not, and Node's own resolver does not.
 * tsc never rewrites a specifier, so the form in src is the form that ships, and CI greps for one
 * that is missing.
 */
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "dist",
        "rootDir": "src",
        "incremental": false,
        "plugins": []
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
